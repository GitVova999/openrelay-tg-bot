# Copy to .env and fill.

# --- Telegram --------------------------------------------------------
# Create an app at https://my.telegram.org/apps — takes ~2 minutes.
TG_API_ID=
TG_API_HASH=
# BotFather token. Empty for ingest-only (Docker-tier can defer until ready).
TG_BOT_TOKEN=
TG_SESSION_NAME=openrelay_ingest

# --- Database --------------------------------------------------------
POSTGRES_DSN=postgresql+asyncpg://openrelay:openrelay@localhost:5432/openrelay_tg
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=openrelay

# --- OpenRelay -------------------------------------------------------
OPENRELAY_BASE_URL=https://openrelay.hggfffdfy687.workers.dev
# Simple-tier master seed for deriving per-channel subaccounts.
# Docker-tier leaves this empty and provides its own wallet key below.
TREASURY_MASTER_SEED_HEX=

# --- Docker-tier wallet keys (only for self-hosted) ------------------
# EVM private key for Base USDC payments.
OPENRELAY_WALLET_PRIVATE_KEY=
# Optional Solana key (base58 or JSON array).
OPENRELAY_SOLANA_PRIVATE_KEY=

# --- Feature flags ---------------------------------------------------
SETUP_FEE_ENABLED=false
SETUP_FEE_SIMPLE_USD=75.0
SETUP_FEE_DOCKER_USD=25.0
MAX_USD_PER_REQUEST=0.05
